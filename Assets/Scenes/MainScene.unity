  m_Script: {fileID: 11500000, guid: e2d91b6775d7b7e46a33bc34f84c16c6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::GameHelpManager
  languageSelector: {fileID: 1956226453}
  gameModeSelector: {fileID: 1956226453}
  startMachine: {fileID: 52879954}
  emergenyStop: {fileID: 2115833512}
  drillSpeedKnob: {fileID: 2120223112}
  materialClamp: {fileID: 816699484}
  shield: {fileID: 1403854800}
  drillBit: {fileID: 1198830993}
  stopMachine: {fileID: 0}
  heightCrank: {fileID: 1797180333}
  leftRightCrank: {fileID: 1605024484}
  forwardBackCrank: {fileID: 2098235863}
  startMachineTextEnglish: Starts the drill machine and powers the motor so the drill
    bit can rotate
  emergenyStopTextEnglish: Immediately stops the machine in an emergency. Use only
    when something goes wrong
  drillSpeedKnobTextEnglish: Adjusts how fast the drill bit spins.
  materialClampTextEnglish: Holds the material firmly in place while drilling
  shieldTextEnglish: 'Clear protective cover in front of the drill bit. Protects
    the user from chips and debris. Machine will not turn on if the shield is not
    on it '
  drillBitTextEnglish: The cutting tool that drills into the material
  stopMachineTextEnglish: 
  heightCrankTextEnglish: Moves the Drill  up or down. Used to adjust the distance
    between the drill bit and the material
  leftRightCranktextEnglish: Moves the table left or right
  forwardBackCrankTextEnglish: Moves the table forward or backward
  startMachineTextDutch: Start de boormachine en zet de motor aan zodat de boor kan
    draaien.
  emergenyStopTextDutch: Stopt de machine onmiddellijk in geval van nood.
  drillSpeedKnobTextDutch: Past de snelheid van de boor aan.
  materialClampTextDutch: Houdt het materiaal stevig op zijn plaats tijdens het boren.
  shieldTextDutch: 'Doorzichtige beschermkap voor de boor. Beschermt de gebruiker
    tegen spanen en rondvliegend materiaal. De machine start niet als de beschermkap
    niet geplaatst is. '
  drillBitTextDutch: Het snijgereedschap dat in het materiaal boort.
  stopMachineTextDutch: 
  heightCrankTextDutch: 'Beweegt de boor omhoog of omlaag. Wordt gebruikt om de afstand
    tussen de boor en het materiaal aan te passen. '
  leftRightCranktextDutch: Beweegt de tafel naar links of rechts.
  forwardBackCrankTextDutch: Beweegt de tafel naar voren of naar achteren.
